BOT_TOKEN=123456:telegram_bot_token
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
ALLOWED_USERS=111111111,222222222

# polling для локальной разработки, webhook для Cloudflare Tunnel / HTTPS-домена
APP_MODE=webhook
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-this-secret-token
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
DROP_PENDING_UPDATES=true

# Если используете Cloudflare Tunnel из docker-compose:
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
